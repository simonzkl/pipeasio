#!/usr/bin/env bash
set -euo pipefail

src="@CMAKE_CURRENT_SOURCE_DIR@/unix_abi_layout.c"
include_dir="@CMAKE_SOURCE_DIR@/src/wow64"
gcc32="@I686_W64_MINGW_GCC@"
host_cc="@CMAKE_C_COMPILER@"
host_include_flags="@WOW64_HOST_INCLUDE_FLAGS@"

"$gcc32" -std=c11 -Wall -Wextra -Werror \
    -I "$include_dir" \
    -DEXPECTED_POINTER_SIZE=4 \
    -c "$src" \
    -o unix_abi_layout.i386.o

"$host_cc" -std=c11 -Wall -Wextra -Werror \
    $host_include_flags \
    -DEXPECTED_POINTER_SIZE=8 \
    -c "$src" \
    -o unix_abi_layout.x86_64.o

printf 'ok - WoW64 unixlib ABI layout is stable across i386 and x86_64\n'
